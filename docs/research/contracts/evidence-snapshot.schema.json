{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insider-alerts.local/schemas/evidence-snapshot-v1.json",
  "title": "Append-only point-in-time evidence snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "hypothesis_id",
    "recorded_at_utc",
    "enrollment_state",
    "confirmatory_enrollment_sequence",
    "supersedes_snapshot_id",
    "record_sha256",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "format": "uuid"},
    "hypothesis_id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*-V[0-9]+$"},
    "recorded_at_utc": {"$ref": "#/$defs/datetime"},
    "enrollment_state": {
      "enum": [
        "pending_entry_selection",
        "enrolled",
        "ineligible",
        "overlap_suppressed",
        "capacity_suppressed",
        "missed"
      ]
    },
    "confirmatory_enrollment_sequence": {
      "description": "Null unless enrollment_state is enrolled; then positive and gap-free.",
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
    },
    "supersedes_snapshot_id": {
      "oneOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]
    },
    "record_sha256": {
      "allOf": [{"$ref": "#/$defs/sha256"}],
      "description": "SHA-256 of the complete envelope serialized as RFC 8785 canonical JSON after removing only record_sha256."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "timing",
        "versions",
        "classification",
        "observations",
        "errors",
        "provenance"
      ],
      "properties": {
        "signal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packet_id",
            "accession_number",
            "issuer_cik",
            "issuer_symbol",
            "form_type",
            "decision",
            "reporting_owner_ciks"
          ],
          "properties": {
            "packet_id": {"type": "string", "minLength": 1},
            "accession_number": {"type": "string", "minLength": 1},
            "issuer_cik": {"type": "string", "pattern": "^[0-9]{1,10}$"},
            "issuer_symbol": {"type": "string", "minLength": 1},
            "form_type": {"enum": ["3", "3/A", "4", "4/A", "5", "5/A"]},
            "decision": {"enum": ["approve", "reject"]},
            "reporting_owner_ciks": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[0-9]{1,10}$"}
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sec_filed_at_utc",
            "source_first_observed_at_utc",
            "decision_at_utc",
            "notification_requested_at_utc",
            "notification_responded_at_utc",
            "client_received_at_utc",
            "monotonic_capture_duration_ms",
            "clock_skew_status"
          ],
          "properties": {
            "sec_filed_at_utc": {"$ref": "#/$defs/nullable_datetime"},
            "source_first_observed_at_utc": {"$ref": "#/$defs/datetime"},
            "decision_at_utc": {"$ref": "#/$defs/datetime"},
            "notification_requested_at_utc": {"$ref": "#/$defs/nullable_datetime"},
            "notification_responded_at_utc": {"$ref": "#/$defs/nullable_datetime"},
            "client_received_at_utc": {"$ref": "#/$defs/nullable_datetime"},
            "monotonic_capture_duration_ms": {"type": "integer", "minimum": 0},
            "clock_skew_status": {"enum": ["valid", "suspect", "unknown"]}
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "git_commit",
            "source_fingerprint_sha256",
            "policy_sha256",
            "classifier_version",
            "model_id",
            "prompt_sha256",
            "configuration_sha256"
          ],
          "properties": {
            "git_commit": {"$ref": "#/$defs/sha1"},
            "source_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
            "policy_sha256": {"$ref": "#/$defs/sha256"},
            "classifier_version": {"$ref": "#/$defs/nullable_string"},
            "model_id": {"$ref": "#/$defs/nullable_string"},
            "prompt_sha256": {"$ref": "#/$defs/nullable_sha256"},
            "configuration_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "owner_cik",
            "classification_year",
            "cutoff_at_utc",
            "transaction_owner_mapping",
            "history_coverage_complete",
            "left_censored",
            "history_input_sha256"
          ],
          "properties": {
            "state": {
              "enum": [
                "routine",
                "opportunistic",
                "unpartitionable",
                "ambiguous_multi_owner"
              ]
            },
            "owner_cik": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^[0-9]{1,10}$"}
              ]
            },
            "classification_year": {"type": "integer", "minimum": 2000},
            "cutoff_at_utc": {"$ref": "#/$defs/datetime"},
            "transaction_owner_mapping": {"enum": ["exact", "ambiguous", "missing"]},
            "history_coverage_complete": {"type": "boolean"},
            "left_censored": {"type": "boolean"},
            "history_input_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sec_source",
            "market_context",
            "options_surface",
            "owner_history",
            "notification_transport"
          ],
          "properties": {
            "sec_source": {"$ref": "#/$defs/observation"},
            "market_context": {"$ref": "#/$defs/observation"},
            "options_surface": {"$ref": "#/$defs/observation"},
            "owner_history": {"$ref": "#/$defs/observation"},
            "notification_transport": {"$ref": "#/$defs/observation"}
          }
        },
        "errors": {
          "type": "array",
          "items": {"$ref": "#/$defs/error"}
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_id_sha256", "process_id", "writer", "append_only_sequence"],
          "properties": {
            "host_id_sha256": {"$ref": "#/$defs/sha256"},
            "process_id": {"type": "integer", "minimum": 1},
            "writer": {"type": "string", "minLength": 1},
            "append_only_sequence": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"enrollment_state": {"const": "enrolled"}}},
      "then": {
        "properties": {
          "confirmatory_enrollment_sequence": {"type": "integer", "minimum": 1},
          "payload": {
            "properties": {
              "signal": {
                "properties": {
                  "decision": {"const": "approve"},
                  "reporting_owner_ciks": {"minItems": 1, "maxItems": 1}
                }
              },
              "versions": {
                "properties": {
                  "classifier_version": {"type": "string", "minLength": 1}
                }
              },
              "classification": {
                "properties": {
                  "state": {"const": "opportunistic"},
                  "owner_cik": {"type": "string", "pattern": "^[0-9]{1,10}$"},
                  "transaction_owner_mapping": {"const": "exact"},
                  "history_coverage_complete": {"const": true},
                  "left_censored": {"const": false}
                }
              },
              "observations": {
                "properties": {
                  "owner_history": {
                    "properties": {"status": {"const": "captured"}}
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {"confirmatory_enrollment_sequence": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "nullable_datetime": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/datetime"}]
    },
    "nullable_string": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    },
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "kind", "message", "retryable"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "as_of_utc",
        "observed_at_utc",
        "source",
        "artifact_ref",
        "artifact_sha256",
        "values",
        "error"
      ],
      "properties": {
        "status": {"enum": ["captured", "missing", "error", "not_applicable"]},
        "as_of_utc": {"$ref": "#/$defs/nullable_datetime"},
        "observed_at_utc": {"$ref": "#/$defs/datetime"},
        "source": {"type": "string", "minLength": 1},
        "artifact_ref": {"$ref": "#/$defs/nullable_string"},
        "artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "values": {"oneOf": [{"type": "null"}, {"type": "object"}]},
        "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "captured"}}},
          "then": {
            "properties": {
              "as_of_utc": {"$ref": "#/$defs/datetime"},
              "values": {"type": "object"},
              "error": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "error"}}},
          "then": {"properties": {"error": {"$ref": "#/$defs/error"}}}
        }
      ]
    }
  }
}
